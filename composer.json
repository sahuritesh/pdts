{
    "name": "local/pdts",
    "type": "project",
    "description": "PDTS (Project Delay Tracking System) — Laravel 8 admin panel.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "barryvdh/laravel-dompdf": "^2.0",
        "doctrine/dbal": "^3.8",
        "fruitcake/laravel-cors": "^2.0",
        "google/apiclient": "*",
        "google/auth": "^1.41",
        "guzzlehttp/guzzle": "*",
        "intervention/image": "^2.7",
        "kreait/firebase-php": "^7.16",
        "laravel/framework": "^8.75",
        "laravel/sanctum": "^2.11",
        "laravel/tinker": "^2.5",
        "maatwebsite/excel": "^3.1",
        "mpdf/mpdf": "^8.2",
        "myclabs/php-enum": "^1.8",
        "paytm/js-checkout": "dev-master",
        "phpoffice/phpspreadsheet": "^1.29",
        "phpoffice/phpword": "^1.4",
        "razorpay/razorpay": "^2.8",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/pdf-to-image": "^2.2",
        "yajra/laravel-datatables-oracle": "^9.21"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^5.10",
        "phpunit/phpunit": "^9.5.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Http/common_helper.php",
            "app/Models/Common_model.php",
            "config/constants.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "app/Http/common_helper.php",
            "config/constants.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php scripts/apply-phpspreadsheet-zipstream-v3-fix.php",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php scripts/patch-platform-check.php",
            "@php scripts/apply-phpspreadsheet-zipstream-v3-fix.php",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
